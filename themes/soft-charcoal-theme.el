;;; soft-charcoal-theme.el --- Muted charcoal theme -*- lexical-binding: t; -*-
;; Author: ChatGPT
;; Version: 0.1
;; Package-Requires: ((emacs "26.1"))
;; Keywords: faces, theme
;;; Commentary:
;; Soft neutral charcoal, restrained syntax colors, readable secondary text.
;;; Code:
(deftheme soft-charcoal "Soft charcoal with restrained, readable syntax colors.")
(let ((bg "#303235") (bg-alt "#34373A") (bg-hi "#41464A")
      (fg "#D8DAD7") (fg-muted "#ACB5AD")
      (blue "#A8BFCE") (peach "#DEB09B")
      (purple "#BCAACB") (green "#A6BFA6")
      (yellow "#D1BE91") (red "#D5A0A0")
      (cyan "#A3C4C5"))
  (custom-theme-set-faces
   'soft-charcoal
   `(default ((t (:background ,bg :foreground ,fg))))
   `(cursor ((t (:background ,fg))))
   `(fringe ((t (:background ,bg :foreground ,fg-muted))))
   `(region ((t (:background ,bg-hi :extend t))))
   `(highlight ((t (:background ,bg-hi))))
   `(hl-line ((t (:background ,bg-alt :extend t))))
   `(shadow ((t (:foreground ,fg-muted))))
   `(link ((t (:foreground ,cyan :underline t))))
   `(error ((t (:foreground ,red :weight bold))))
   `(warning ((t (:foreground ,yellow))))
   `(success ((t (:foreground ,green))))
   `(minibuffer-prompt ((t (:foreground ,blue :weight bold))))
   `(mode-line ((t (:background ,bg-hi :foreground ,fg :box nil))))
   `(mode-line-inactive ((t (:background ,bg-alt :foreground ,fg-muted :box nil))))
   `(header-line ((t (:background ,bg-alt :foreground ,fg))))
   `(vertical-border ((t (:foreground ,bg-hi))))
   `(line-number ((t (:foreground ,fg-muted :background ,bg))))
   `(line-number-current-line ((t (:foreground ,fg :background ,bg :weight bold))))
   `(isearch ((t (:background ,yellow :foreground ,bg))))
   `(lazy-highlight ((t (:background ,bg-hi :foreground ,fg))))
   `(show-paren-match ((t (:foreground ,cyan :weight bold :underline t))))
   `(font-lock-builtin-face ((t (:foreground ,purple))))
   `(font-lock-comment-face ((t (:foreground ,fg-muted))))
   `(font-lock-comment-delimiter-face ((t (:foreground ,fg-muted))))
   `(font-lock-constant-face ((t (:foreground ,purple))))
   `(font-lock-doc-face ((t (:foreground ,green))))
   `(font-lock-function-name-face ((t (:foreground ,blue))))
   `(font-lock-keyword-face ((t (:foreground ,blue))))
   `(font-lock-string-face ((t (:foreground ,peach))))
   `(font-lock-type-face ((t (:foreground ,green))))
   `(font-lock-variable-name-face ((t (:foreground ,fg))))
   `(font-lock-warning-face ((t (:foreground ,red :weight bold))))
   `(font-lock-preprocessor-face ((t (:foreground ,purple))))
   `(font-lock-negation-char-face ((t (:foreground ,red))))
   `(font-lock-escape-face ((t (:foreground ,yellow))))
   `(font-lock-number-face ((t (:foreground ,purple))))
   `(font-lock-operator-face ((t (:foreground ,fg))))
   `(font-lock-punctuation-face ((t (:foreground ,fg))))
   `(font-lock-bracket-face ((t (:foreground ,fg))))
   `(org-level-1 ((t (:foreground ,blue :weight bold :height 1.12))))
   `(org-level-2 ((t (:foreground ,green :weight bold :height 1.06))))
   `(org-level-3 ((t (:foreground ,peach :weight bold))))
   `(org-level-4 ((t (:foreground ,purple))))
   `(org-block ((t (:background ,bg-alt :foreground ,fg :extend t))))
   `(org-block-begin-line ((t (:foreground ,fg-muted :background ,bg-alt :extend t))))
   `(org-block-end-line ((t (:foreground ,fg-muted :background ,bg-alt :extend t))))
   `(org-code ((t (:foreground ,peach))))
   `(org-verbatim ((t (:foreground ,green))))
   `(org-link ((t (:foreground ,cyan :underline t))))
   `(org-todo ((t (:foreground ,red :weight bold))))
   `(org-done ((t (:foreground ,green :weight bold))))
   `(org-date ((t (:foreground ,purple))))
   `(org-special-keyword ((t (:foreground ,fg-muted))))
   `(org-meta-line ((t (:foreground ,fg-muted))))
   `(org-document-title ((t (:foreground ,blue :weight bold :height 1.2))))
   `(dired-directory ((t (:foreground ,blue :weight bold))))
   `(dired-symlink ((t (:foreground ,cyan))))
   `(dired-marked ((t (:foreground ,yellow))))
   ;; diredfl: legible filenames, subdued metadata, meaningful accents.
   `(diredfl-autofile-name ((t (:foreground ,fg))))
   `(diredfl-compressed-file-name ((t (:foreground ,yellow))))
   `(diredfl-compressed-file-suffix ((t (:foreground ,peach))))
   `(diredfl-date-time ((t (:foreground ,fg-muted))))
   `(diredfl-deletion ((t (:foreground ,red :weight bold))))
   `(diredfl-dir-heading ((t (:foreground ,blue :weight bold :background ,bg-alt))))
   `(diredfl-dir-name ((t (:foreground ,blue :weight bold))))
   `(diredfl-dir-priv ((t (:foreground ,blue))))
   `(diredfl-exec-priv ((t (:foreground ,green))))
   `(diredfl-executable-tag ((t (:foreground ,green))))
   `(diredfl-file-name ((t (:foreground ,fg))))
   `(diredfl-file-suffix ((t (:foreground ,fg-muted))))
   `(diredfl-flag-mark ((t (:foreground ,yellow :weight bold))))
   `(diredfl-flag-mark-line ((t (:background ,bg-hi :extend t))))
   `(diredfl-ignored-file-name ((t (:foreground ,fg-muted :sland italic))))
   `(diredfl-link-priv ((t (:foreground ,cyan))))
   `(diredfl-no-priv ((t (:foreground ,fg-muted))))
   `(diredfl-number ((t (:foreground ,purple))))
   `(diredfl-other-priv ((t (:foreground ,fg-muted))))
   `(diredfl-rare-priv ((t (:foreground ,fg-muted))))
   `(diredfl-read-priv ((t (:foreground ,yellow))))
   `(diredfl-symlink ((t (:foreground ,cyan))))
   `(diredfl-tagged-autofile-name ((t (:foreground ,yellow))))
   `(diredfl-write-priv ((t (:foreground ,peach))))
   ;; Eat Terminal - soft charcoal ANSI Palette
   `(eat-term-color-0 ((t (:foreground "#303235"))))
   `(eat-term-color-1 ((t (:foreground "#D5A0A0"))))
   `(eat-term-color-2 ((t (:foreground "#A6BFA6"))))
   `(eat-term-color-3 ((t (:foreground "#D1BE91"))))
   `(eat-term-color-4 ((t (:foreground "#A8BFCE"))))
   `(eat-term-color-5 ((t (:foreground "#BCAACB"))))
   `(eat-term-color-6 ((t (:foreground "#A3C4C5"))))
   `(eat-term-color-7 ((t (:foreground "#D8DAD7"))))
   ;; Bright ANSI dcolors
   `(eat-term-color-8 ((t (:foreground "#62686C"))))
   `(eat-term-color-9 ((t (:foreground "#E2B0B0"))))
   `(eat-term-color-10 ((t (:foreground "#B8CEB8"))))
   `(eat-term-color-11 ((t (:foreground "#DFCEA6"))))
   `(eat-term-color-12 ((t (:foreground "#BCD0DD"))))
   `(eat-term-color-13 ((t (:foreground "#CDBDDA"))))
   `(eat-term-color-14 ((t (:foreground "#B5D3D3"))))
   `(eat-term-color-15 ((t (:foreground "#ECEDE9"))))   
   `(completions-common-part ((t (:foreground ,blue :weight bold))))
   `(corfu-default ((t (:background ,bg-alt :foreground ,fg))))
   `(corfu-current ((t (:background ,bg-hi :foreground ,fg))))
   `(vertico-current ((t (:background ,bg-hi :foreground ,fg :extend t))))
   `(magit-section-heading ((t (:foreground ,blue :weight bold))))
   `(magit-branch-local ((t (:foreground ,cyan))))
   `(magit-diff-added ((t (:foreground ,green))))
   `(magit-diff-removed ((t (:foreground ,red))))
   `(diff-added ((t (:foreground ,green))))
   `(diff-removed ((t (:foreground ,red))))))
;;;###autoload
(when (and load-file-name (boundp 'custom-theme-load-path))
  (add-to-list 'custom-theme-load-path (file-name-directory load-file-name)))
(provide-theme 'soft-charcoal)
;;; soft-charcoal-theme.el ends here
